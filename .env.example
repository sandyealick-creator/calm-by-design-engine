# Calm by Design - assessment engine environment variables
#
# Copy this file to a real .env (or your Cloud Run --set-env-vars / local
# env.yaml) and fill in real values there. Never commit real values.
# This file must only ever contain placeholders.

# --- Required ---------------------------------------------------------------

# Google AI Studio API key (https://aistudio.google.com). Used by google-genai
# to call Gemini for journal-entry classification.
GEMINI_API_KEY=your-gemini-api-key-here

# Airtable personal access token, scoped to the CBD Core base only
# (data.records:read, data.records:write).
AIRTABLE_API_KEY=your-airtable-personal-access-token-here

# Long random string. GHL must send this exact value in the X-Webhook-Secret
# header on every POST to /assess. Generate with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace-with-a-long-random-string

# Long random string used to generate CSRF tokens for the participant-facing
# enroll/check-in/recover pages. Generate the same way as WEBHOOK_SECRET, and
# use a DIFFERENT value from it.
SESSION_SECRET=replace-with-a-different-long-random-string

# --- Optional ----------------------------------------------------------------

# Gemini model string. Defaults to gemini-3.5-flash if unset.
GEMINI_MODEL=gemini-3.5-flash

# Outbound GHL inbound-webhook URL for routing decisions (module/buffer
# delivery). Currently unset in production - GHL's own Airtable-polling
# workflows are the real delivery path, this is a supplemental optional call.
GHL_ROUTING_WEBHOOK=

# Outbound GHL inbound-webhook URL for crisis/medical-emergency alerts to the
# owner. Currently unset in production, same caveat as above.
GHL_CRISIS_WEBHOOK=

# Port to listen on for local `python main.py` runs. Cloud Run sets this
# itself in production; you normally don't need to set it.
PORT=8080
